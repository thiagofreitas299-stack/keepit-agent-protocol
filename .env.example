# Copie para .env e preencha localmente. Nunca commite o .env.
# Credenciais do app Meta (Instagram/Facebook) usadas em /oauth-exchange
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_REDIRECT_URI=https://keepithub.com/oauth/callback
# Onde salvar o token de longa duracao (arquivo criado com permissao 600)
META_TOKEN_PATH=/tmp/ig_new_token.txt

# API keys de clientes do protocolo, formato chave:plano separados por virgula
KEEPIT_API_KEYS=gere_uma_chave_aleatoria:free,gere_outra_chave:pro
